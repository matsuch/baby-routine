# Copie para .env e ajuste. Nunca versione o .env real.

# Chave da API do WAHA. Use exatamente o mesmo valor no campo "Chave da API" do app.
WAHA_API_KEY=troque-por-um-segredo-forte

# Token opcional do worker. Se preenchido, o app precisa do mesmo em "Token do worker".
WORKER_TOKEN=

# Origem permitida (CORS). Em produção, a URL do seu app, ex.: https://matsuch.github.io
CORS_ORIGIN=*

# Janela (min) para considerar um lembrete "na hora" e dispará-lo.
WINDOW_MIN=8
